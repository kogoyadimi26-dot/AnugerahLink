# Salin ke .env lalu isi. Jangan commit file .env ke git.
DOMAIN=toko.contoh.id
PUBLIC_URL=https://toko.contoh.id

# Akun pemilik (wajib diisi, kata sandi minimal 12 karakter)
OWNER_NAME=Nama Pemilik
OWNER_EMAIL=pemilik@contoh.id
OWNER_PASSWORD=

# Email (opsional, isi bila sudah punya penyedia)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# WhatsApp (opsional)
WA_API_URL=
WA_API_TOKEN=

# Pembayaran Midtrans (kosongkan untuk mode simulasi)
MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox

# Cadangan
BACKUP_KEEP_DAYS=30
